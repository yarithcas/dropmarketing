# ─────────────────────────────────────────────────────────────────────────────
# TrendHunter configuration. Every variable is optional: without them the app
# runs in DEMO MODE (clearly labelled sample data, browser-stored workspace,
# demo billing). Never commit real values. Only NEXT_PUBLIC_* reach the browser.
# ─────────────────────────────────────────────────────────────────────────────

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database & authentication (Supabase) — enables accounts, persistence, RLS, live data
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=            # server only: background jobs, webhooks, integrations

# AI provider (Anthropic Claude) — otherwise the rule-based analyst is used
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Payments (Stripe) — otherwise demo billing mode
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=                     # price_… (recurring)
STRIPE_PRICE_BUSINESS=                # price_… (recurring)
STRIPE_PRICE_PRO_YEARLY=              # optional yearly price_…; yearly billing is offered only when both are set
STRIPE_PRICE_BUSINESS_YEARLY=

# Shopify (merchant's own store, OAuth) — otherwise mock store mode
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_SCOPES=read_products,read_orders,read_inventory
SHOPIFY_API_VERSION=2025-07
ENCRYPTION_KEY=                       # 32 random bytes, base64: openssl rand -base64 32

# Email alerts (Resend) — otherwise in-app notifications only
RESEND_API_KEY=
EMAIL_FROM="TrendHunter <alerts@your-domain.com>"
SUPPORT_EMAIL=                        # inbox receiving support requests (Business requests are tagged [PRIORITY])

# Background jobs — Vercel Cron sends "Authorization: Bearer $CRON_SECRET"
CRON_SECRET=

# Demo mode only: the demo dataset rolls daily (snapshot = yesterday, UTC). Set YYYY-MM-DD to pin it (tests).
# DEMO_SNAPSHOT=

# Data connectors (official APIs / licensed providers)
META_AD_LIBRARY_ACCESS_TOKEN=
META_GRAPH_VERSION=v23.0
TIKTOK_RESEARCH_CLIENT_KEY=
TIKTOK_RESEARCH_CLIENT_SECRET=
PINTEREST_API_TOKEN=
SEARCH_TRENDS_API_KEY=
STOREFRONT_CRAWLER_ENABLED=false      # public listings only, robots.txt respected, 1 req/s/host
LICENSED_DATA_PROVIDER_URL=
LICENSED_DATA_PROVIDER_KEY=
